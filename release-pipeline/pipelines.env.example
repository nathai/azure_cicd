# ====================================================================
# Azure DevOps Release Pipeline Configuration
# ====================================================================
# Copy this file and customize: cp pipelines.env.example my-app.env
# Run: ./import-release-pipeline.sh my-app.env
# ====================================================================

# Personal Access Token
AZURE_DEVOPS_PAT="your-pat-token-here"

# OPTION 1: Repository URL (Recommended - auto-extracts org, project, repo)
REPO_URL="https://dev.azure.com/{org}/{project}/_git/{repo}"

# OPTION 2: Manual configuration (leave REPO_URL empty if using this)
ORGANIZATION_NAME="your-org-name"
REPO_PROJECT_NAME="YourRepoProjectName"
REPO_NAME="your-repo-name"

# Pipeline configuration
PIPELINE_NAME="Multi-Stage Auto Release"
PIPELINE_PROJECT_NAME=""

# Pipeline Variables (optional - available to all stages)
# Format: VAR_NAME=value (one per line)
# Example:
#   dockerfile_name=MyApp/Dockerfile
#   image_name=myapp-api
#   tag=latest
PIPELINE_VARIABLES=""

# Development Environment Variables (optional)
# Format: VAR_NAME=value (one per line)
# Example: acr_name=myacr-dev
DEVELOPMENT_VARIABLES=""

# Staging Environment Variables (optional)
# Example: acr_name=myacr-staging
STAGING_VARIABLES=""

# Production Environment Variables (optional)
# Example: acr_name=myacr-prod
PRODUCTION_VARIABLES=""

# Deployment Groups (get IDs from Azure DevOps)
DEVELOPMENT_DEPLOYMENT_GROUP_ID=""
DEVELOPMENT_TAGS="web-server,dev"

STAGING_DEPLOYMENT_GROUP_ID=""
STAGING_TAGS="web-server,staging"

PRODUCTION_DEPLOYMENT_GROUP_ID=""
PRODUCTION_TAGS="web-server,production"

# Branch Triggers
DEFAULT_BRANCH="main"
DEVELOPMENT_BRANCHES="dev1,dev2"
STAGING_BRANCHES="stage"
PRODUCTION_BRANCHES="prod"

# Deployment Scripts
DEVELOPMENT_SCRIPT='#!/bin/bash
echo "=========================================="
echo "Starting Deployment to Development"
echo "=========================================="
echo "Server: $(hostname)"
echo "User: $(whoami)"
echo "Working directory: $(pwd)"
echo "Artifact location: $(System.DefaultWorkingDirectory)"
echo ""

# Add your deployment commands here
# Example:
# sudo systemctl stop myapp-dev
# sudo cp -r $(System.DefaultWorkingDirectory)/_MyApp/drop/* /var/www/dev/
# sudo chown -R www-data:www-data /var/www/dev/
# sudo systemctl start myapp-dev

echo "Deployment to Development completed successfully!"
echo "=========================================="'

STAGING_SCRIPT='#!/bin/bash
echo "=========================================="
echo "Starting Deployment to Staging"
echo "=========================================="
echo "Server: $(hostname)"
echo "User: $(whoami)"
echo "Working directory: $(pwd)"
echo "Artifact location: $(System.DefaultWorkingDirectory)"
echo ""

# Add your deployment commands here
# Example:
# sudo systemctl stop myapp-staging
# sudo cp -r $(System.DefaultWorkingDirectory)/_MyApp/drop/* /var/www/staging/
# sudo chown -R www-data:www-data /var/www/staging/
# sudo systemctl start myapp-staging

echo "Deployment to Staging completed successfully!"
echo "=========================================="'

PRODUCTION_SCRIPT='#!/bin/bash
echo "=========================================="
echo "Starting Deployment to Production"
echo "=========================================="
echo "Server: $(hostname)"
echo "User: $(whoami)"
echo "Working directory: $(pwd)"
echo "Artifact location: $(System.DefaultWorkingDirectory)"
echo ""

# Add your deployment commands here
# Example:
# sudo systemctl stop myapp
# sudo cp -r $(System.DefaultWorkingDirectory)/_MyApp/drop/* /var/www/production/
# sudo chown -R www-data:www-data /var/www/production/
# sudo systemctl start myapp

echo "Deployment to Production completed successfully!"
echo "=========================================="'
