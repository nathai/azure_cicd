# ====================================================================
# Azure DevOps Release Pipeline Configuration
# ====================================================================
#
# This is a template file. To use it:
# 1. Copy this file: cp pipelines.env.example pipelines.env
# 2. Fill in your values in pipelines.env
# 3. Run: ./import-release-pipeline.sh pipelines.env
#
# You can create multiple pipeline configurations:
#   - my-app.env
#   - api-service.env
#   - web-frontend.env
# Then import each: ./import-release-pipeline.sh my-app.env
#
# NOTE: *.env files are git-ignored for security
# ====================================================================

# ==========================================
# Azure DevOps Organization & Authentication
# ==========================================

# Organization name (from URL: https://dev.azure.com/THIS-NAME)
ORGANIZATION_NAME="your-org-name"

# Personal Access Token - Keep this secure!
# Create at: https://dev.azure.com/{org}/_usersSettings/tokens
# Required scopes:
#   - Release (Read, write, execute & manage)
#   - Code (Read) - if accessing repo from different project
#   - Project and Team (Read)
#   - Deployment Groups (Manage)
AZURE_DEVOPS_PAT="your-pat-token-here"

# ==========================================
# Project & Repository Configuration
# ==========================================

# Repository Project (project containing the source code)
REPO_PROJECT_NAME="YourRepoProjectName"

# Repository name
REPO_NAME="your-repo-name"

# Pipeline Project (project where release pipeline will be created)
# Leave empty to use same project as repository
PIPELINE_PROJECT_NAME=""  # Optional: "YourPipelineProjectName"

# ==========================================
# Deployment Groups
# ==========================================
# Create deployment groups first in Azure DevOps:
# Pipelines → Deployment groups → New deployment group
# Get IDs from URL: .../_settings/agentqueues?queueId=XX

# Development Stage
DEVELOPMENT_DEPLOYMENT_GROUP_ID=""
DEVELOPMENT_TAGS="web-server,dev"  # Comma-separated tags

# Staging Stage
STAGING_DEPLOYMENT_GROUP_ID=""
STAGING_TAGS="web-server,staging"

# Production Stage
PRODUCTION_DEPLOYMENT_GROUP_ID=""
PRODUCTION_TAGS="web-server,production"

# ==========================================
# Branch Triggers
# ==========================================
# Configure which branches trigger which stages
# Multiple branches separated by comma (no spaces)

# Default branch for manual releases
DEFAULT_BRANCH="main"

# Development Stage - triggered by these branches
DEVELOPMENT_BRANCHES="dev1,dev2"

# Staging Stage - triggered by these branches
STAGING_BRANCHES="stage"

# Production Stage - triggered by these branches
PRODUCTION_BRANCHES="prod"

# ==========================================
# Deployment Scripts
# ==========================================
# Customize deployment logic for each stage
# Scripts run on target servers in deployment groups

# Development Stage Script
DEVELOPMENT_SCRIPT='#!/bin/bash
echo "=========================================="
echo "Starting Deployment to Development"
echo "=========================================="
echo "Server: $(hostname)"
echo "User: $(whoami)"
echo "Working directory: $(pwd)"
echo "Artifact location: $(System.DefaultWorkingDirectory)"
echo ""

# Add your deployment commands here
# Example:
# sudo systemctl stop myapp-dev
# sudo cp -r $(System.DefaultWorkingDirectory)/_MyApp/drop/* /var/www/dev/
# sudo chown -R www-data:www-data /var/www/dev/
# sudo systemctl start myapp-dev

echo "Deployment to Development completed successfully!"
echo "=========================================="'

# Staging Stage Script
STAGING_SCRIPT='#!/bin/bash
echo "=========================================="
echo "Starting Deployment to Staging"
echo "=========================================="
echo "Server: $(hostname)"
echo "User: $(whoami)"
echo "Working directory: $(pwd)"
echo "Artifact location: $(System.DefaultWorkingDirectory)"
echo ""

# Add your deployment commands here
# Example:
# sudo systemctl stop myapp-staging
# sudo cp -r $(System.DefaultWorkingDirectory)/_MyApp/drop/* /var/www/staging/
# sudo chown -R www-data:www-data /var/www/staging/
# sudo systemctl start myapp-staging

echo "Deployment to Staging completed successfully!"
echo "=========================================="'

# Production Stage Script
PRODUCTION_SCRIPT='#!/bin/bash
echo "=========================================="
echo "Starting Deployment to Production"
echo "=========================================="
echo "Server: $(hostname)"
echo "User: $(whoami)"
echo "Working directory: $(pwd)"
echo "Artifact location: $(System.DefaultWorkingDirectory)"
echo ""

# Add your deployment commands here
# Example:
# sudo systemctl stop myapp
# sudo cp -r $(System.DefaultWorkingDirectory)/_MyApp/drop/* /var/www/production/
# sudo chown -R www-data:www-data /var/www/production/
# sudo systemctl start myapp

echo "Deployment to Production completed successfully!"
echo "=========================================="'

# ==========================================
# Advanced Configuration (Auto-populated)
# ==========================================
# Leave these empty - script will fetch automatically

REPO_PROJECT_ID=""
PIPELINE_PROJECT_ID=""
REPO_ID=""
