                "script": "echo \"Server: $(hostname)\"\n\necho \"User: $(whoami)\"\n\necho \"Artifact location: $(System.ArtifactsDirectory)\"\n\ncd  $(System.ArtifactsDirectory)/$(working_folder)\n\necho \"Working directory: $(pwd)\"\n\n\ndocker build -t $(acr_name).azurecr.io/$(image_name):$(tag) -f $(dockerfile_name) .\n\ndocker push $(acr_name).azurecr.io/$(image_name):$(tag)\n\n",
                "workingDirectory": "$(System.ArtifactsDirectory)/$(working_folder)",
                "failOnStderr": "false"
              }
            },
            {
              "environment": {},
              "taskId": "d9bafed4-0b18-4f58-968d-86655b4d2ce9",
              "version": "2.*",
              "name": "Deploy stack",
              "refName": "",
              "enabled": true,
              "alwaysRun": false,
              "continueOnError": false,
              "timeoutInMinutes": 0,
              "retryCountOnTaskFailure": 3,
              "definitionType": "task",
              "overrideInputs": {},
              "condition": "succeeded()",
              "inputs": {
                "script": "cd $(stack_folder)\necho \"Working directory: $(pwd)\"\ndocker stack rm $(stack_name)\nsleep 5\ndocker stack deploy -c $(stack_yaml) $(stack_name) --with-registry-auth\n",
                "workingDirectory": "$(stack_folder) ",
                "failOnStderr": "false"
              }
            }
          ]
        },
