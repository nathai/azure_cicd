# Azure DevOps Configuration
org_service_url       = "https://dev.azure.com/your-organization"
personal_access_token = "your-pat-token-here"

# IMPORTANT: These must be existing resources in Azure DevOps
project_name    = "YourExistingProject"
repository_name = "your-existing-repo"

# Branch Configuration
default_branch = "refs/heads/main"  # or "refs/heads/master"

# Build Pipeline (CI)
build_pipeline_name      = "MyApp-CI"
build_pipeline_yaml_path = "azure-pipelines.yml"
build_use_variable_groups = true

# Release Pipeline (CD)
release_pipeline_name      = "MyApp-CD"
release_pipeline_yaml_path = "azure-release-pipeline.yml"
release_use_variable_groups = true

# Variable Group
create_variable_group       = true
variable_group_name         = "MyApp-Variables"
variable_group_description  = "Shared variables for MyApp pipelines"

pipeline_variables = {
  environment = {
    value     = "production"
    is_secret = false
  }
  app_version = {
    value     = "1.0.0"
    is_secret = false
  }
  api_endpoint = {
    value     = "https://api.example.com"
    is_secret = false
  }
  api_key = {
    value     = "your-secret-api-key"
    is_secret = true
  }
  database_connection = {
    value     = "your-connection-string"
    is_secret = true
  }
}

# Environments
create_environments = true
environments = [
  { name = "Development" },
  { name = "Staging" },
  { name = "Production" }
]
